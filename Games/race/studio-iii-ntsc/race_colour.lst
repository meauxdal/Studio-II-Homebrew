012B  A1                		plo r1
012C  F8 0F             		ldi >menuWaitVsync
012E  B1                		phi r1
012F  D1                		sep r1


0130                    scanAccelKey:
0130  E1                		sex r1
0131  62                		out 2
0132  05                		.db 5
0133  F8 00             		ldi 0
0135  3F 3A             		bn4 notBreak
0137  9C                		ghi rHiSpeed
0138  F6                		shr
0139  F6                		shr
