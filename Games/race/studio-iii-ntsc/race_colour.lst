013F  02                		.db 2
0140  F8 3A             		ldi mSpeedHi
0142  A2                		plo rDataPointer
0143  E2                		sex rDataPointer

                        		;conver speed 0-200 to 0-20 to save in rSpeed hi
0144  02                		ldn rDataPointer
0145  FE                		shl 					;mul 10
0146  FE                		shl
0147  FE                		shl
0148  F4                		add
0149  F4                		add
014A  12                		inc rDataPointer
014B  F4                		add
014C  BC                		phi rHiSpeed
014D  12                		inc rDataPointer

014E  FF 0B             		smi MAX_SPEED_ROADSIDE
0150  3B 68             		bnf noNeedDecSpeed
                        		; if speed more MAX_SPEED_ROADSIDE
0152  98                		ghi rHiCarX
0153  FC 37             		adi ROAD_LIMIT
0155  FC 91             		adi 255-ROAD_LIMIT*2
0157  3B 5D             		bnf checkTurn			;and check car X pos, if on roadside then dec dpeed
0159  F8 04             		ldi DEC_SPEED_ROADSIDE
015B  30 6F             		br decSpeedNext
015D                    checkTurn:
015D  02                		ldn rDataPointer
015E  F6                		shr
015F  33 68             		bdf noNeedDecSpeed		;only odd speed for speed flicker
0161  88                		glo rLoWheel
0162  FC 04             		adi WHEEL_LIMIT_SPEEDUP
0164  FC F7             		adi 255-WHEEL_LIMIT_SPEEDUP*2
0166  33 6A             		bdf decSpeed 			;check turn adder more half and not inc speed if true

0168                    noNeedDecSpeed:
0168  37 7A             		b4 incSpeed

016A                    decSpeed:
016A  9C                		ghi rHiSpeed
016B  F4                		add		
016C  32 89             		bz changeSpeedEnd

016E  84                		glo r4buf
016F                    decSpeedNext:
016F  F5                		sd 				;b for -2 for low byte
0170  52                		str rDataPointer
0171  33 89             		bdf changeSpeedEnd
0173  FC 0A             		adi 10
0175  73                		stxd
0176  F8 01             		ldi 1
0178  30 6F             		br decSpeedNext

