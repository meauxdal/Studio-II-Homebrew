0400                    		.org $400
                        ; ---------------------------------------------------------------------------
                        ;  CDP1864 colour. Race has no framebuffer -- displayRefresh points R0 straight
                        ;  at ROM data and re-points it per scanline -- so the 1864 picks its colour
                        ;  cell from the ADDRESS being fetched, not the screen row:
                        ;
                        ;        col_index = {addr[7:5], addr[2:0]}
                        ;
                        ;  addr[2:0] is the byte across the line, exactly as normal. addr[7:5] is the
                        ;  32-byte block the data sits in. So colour attaches to WHICH GRAPHIC is being
                        ;  fetched, not where it lands -- per-element colour, which no framebuffer game
                        ;  on this hardware can have. This table is eight distinct colours, one per
                        ;  block, to read off which element is fed from where.
                        ; ---------------------------------------------------------------------------
0400                    colourInit:
0400  E3                		sex r3					;interrupts are still live at this point in Reset
0401  71                		dis						;and R1 still points at the VideoInt stub, which
0402  23                		.db  $23				;would run all through the loop below. Kill them
                        								;first, exactly as start does: X=2, P=3, IE=0.
                        		;OUT 1 would step the background off blue, but on this machine the
                        		;1861 path takes OUT 1 as display-off as well, so it is left alone.
0403  F8 0B             		ldi $0B					;R4 -> the colour window
0405  B4                		phi r4
0406  F8 00             		ldi 0
0408  A4                		plo r4
0409  F8 04             		ldi >bandTable
040B  B5                		phi r5
040C  F8 25             		ldi <bandTable
040E  A5                		plo r5
040F                    ciBand:
040F  45                		lda r5					;colour for this 32-byte block
0410  A6                		plo r6
0411  F8 08             		ldi 8					;eight cells share it
0413  B6                		phi r6
0414                    ciCell:
0414  86                		glo r6
0415  54                		str r4
0416  14                		inc r4
0417  96                		ghi r6
0418  FF 01             		smi 1
041A  B6                		phi r6
041B  3A 14             		bnz ciCell
041D  84                		glo r4
041E  FB 40             		xri 64
0420  3A 0F             		bnz ciBand
0422  C0 0100           		lbr start

0425  01030707 07060103 bandTable:	.db 1,3,7,7,7,6,1,3		;red magenta white white white cyan red magenta
                        ;
                        ;  Groups 2, 3 and 4 have to share a colour, and that is not a preference.
                        ;  Text on this game straddles them: the status header is display rows 0-4,
                        ;  which is group 3 on row 0 and group 4 below it; the digit line is rows
                        ;  8-15, group 2 on row 8 and group 3 below; and the big AZYA,2020 line is
                        ;  rows 59-66, crossing group 2 into 3 into 4. Give those groups different
                        ;  values and every one of those strings comes out banded -- which is what
                        ;  the first version did, and why the score digits had a green top row on a
                        ;  yellow body.
                        ;
                        ;  White is the pick because group 4 also draws the mountain tops at rows
                        ;  44-47, so the same value that makes the text legible caps the peaks with
                        ;  snow. Groups 5, 6 and 7 keep cyan/red/magenta for the lower slopes and,
                        ;  further down the screen, for the near road and the car. Groups 0 and 1
                        ;  are the far road alone.
                        ;
                        ;  Value 2 is blue, the same as the background, so it is never usable here.


                        ; -----------------------------------------------------------------------------
                        ; Race DX v1.05 fractional-phase preservation
                        ;
                        ; Helpers live in the unused $0430-$04FF gap. Existing code, graphics, tables
                        ; and data retain their v1.05 addresses. The original packed-decimal seconds
                        ; timer is unchanged.
                        ;
                        ; finishRoad is selected on the refresh after drawRoad raises state 12, so R6.0
                        ; has advanced by one hidden timer tick even though whole seconds are no longer
                        ; decremented. Undo that encoded tick before saving the phase. The v1.05 phase
                        ; counter skips 01/11/21/31 hex because it takes an extra increment when the
                        ; low nibble is zero: values ending in 2 therefore need -2; all others need -1.

0430                    		.org $430
0430                    finishRoadPhaseSave:
0430  7A                		req
0431  1A                		inc rRoadSectorAdr
0432  1A                		inc rRoadSectorAdr

0433  86                		glo rLoTimer
0434  A4                		plo r4buf
0435  FA 0F             		ani $0F
0437  FF 02             		smi 2
0439  3A 40             		bnz finishRoadPhaseMinusOne
043B  84                		glo r4buf
043C  FF 02             		smi 2
043E  30 43             		br finishRoadPhaseStore
0440                    finishRoadPhaseMinusOne:
0440  84                		glo r4buf
0441  FF 01             		smi 1
0443                    finishRoadPhaseStore:
0443  A4                		plo r4buf
0444  F8 4A             		ldi <mRacePhase
0446  A2                		plo rDataPointer
0447  84                		glo r4buf
0448  52                		str rDataPointer
0449  12                		inc rDataPointer
044A  F8 01             		ldi 1
044C  52                		str rDataPointer
044D  C0 0453           		lbr finishLapCapture

                        ; Restore the saved LEFT-timer phase on the final countdown transition.  This
                        ; makes the post-finish +60-second award preserve the exact fractional remainder
                        ; instead of allowing the between-road countdown to replace it with a new phase.
0450                    countdownPhaseRestore:
0450  C0 01D3           		lbr countdownPhaseExternal
                        ; Unreachable from countdownPhaseRestore itself; finishRoadPhaseSave enters here.
                        ; Keep elapsedLightTick fixed at $0461.
