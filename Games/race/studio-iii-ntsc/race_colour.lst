0000                    	.org	000h
0000                    	.include "1802.inc"               ; Include the R0-R15 definitions
      = 0000            r0      = 0
      = 0001            r1      = 1
      = 0002            r2      = 2
      = 0003            r3      = 3
      = 0004            r4      = 4
      = 0005            r5      = 5
      = 0006            r6      = 6
      = 0007            r7      = 7
      = 0008            r8      = 8
      = 0009            r9      = 9
      = 000A            ra      = 10
      = 000B            rb      = 11
      = 000C            rc      = 12
      = 000D            rd      = 13
      = 000E            re      = 14
      = 000F            rf      = 15

      = 0800            RAM  = 0800h                              ; System/Data memory page
      = 08BF            RAMStack = RAM+BFh                        ; Initial stack value

0000                    Reset:
0000  90                	        ghi r0               ; Clear accumulator (D=0 on reset)
0001  B1                	        phi r1               ; R1.High = Interrupt
0002  F8 08             	        ldi RAM / 256        ; D = System Memory Page
0004  B2                	        phi r2               ; R2.High = Stack Base
0005  F8 14             	        ldi VideoInt & 255   ; R1.Low = Interrupt Routine
0007  A1                	        plo r1               ;
0008  F8 BF             	        ldi RAMStack & 255   ; R2.Low = Stack Base
000A  A2                	        plo r2               ;
000B  F8 04             		ldi colourInit / 256 ; R3.High = the colour page first
000D  B3                	        phi r3               ;
000E  F8 00             	        ldi colourInit & 255 ; R3.Low
0010  A3                	        plo r3               ;
0011  D3                		sep r3       ; Go to start
0012                    _return:
0012  72                		ldxa
0013  70                		ret
0014                    VideoInt:
0014  22                		dec r2
0015  78                		sav
0016  22                		dec r2
0017  52                		str r2
0018  C4                		nop
0019  C4                		nop
001A  C4                		nop
001B  F8 00             		ldi 00
001D  B0                		phi r0
001E  F8 00             		ldi 00
0020  A0                		plo r0
0021  80                _loop:		glo r0
0022  E2                		sex r2
0023  E2                		sex r2
0024  20                		dec r0
0025  A0                		plo r0
0026  E2                		sex r2
0027  20                		dec r0
0028  A0                		plo r0
0029  E2                		sex r2
002A  20                		dec r0
002B  A0                		plo r0
002C  3C 21             		bn1 _loop
002E  30 12             		br _return



      = 001B            MAX_SEGMENT_Y = 27	;up to 31
      = 0017            MAX_SPEED = 23 ;230
      = 0005            TIMER_START_LO = 5
      = 0006            TIMER_START_HI = 6
      = 0006            START_BEEP_FRAMES = 6
      = 000C            FINAL_BEEP_FRAMES = 12
      = 0001            ROAD_BEEP_TICKS = 1
      = 0006            ROAD_BEEP_GAP_TICKS = 6
      = 00E1            TONE_B4 = 0xE1
      = 0070            TONE_B5 = 0x70
      = 0011            START_PERSPECTIVE_Y = 17
      = 0065            LIGHT_POSITION_Y = 101 ;lower byte
      = 0008            WHEEL_LIMIT = 8 ;-8..8
      = 0004            WHEEL_LIMIT_SPEEDUP = 4
      = 003F            CAR_X_LIMIT = 63 ;-63..63
      = 0007            SPEED_SKID_START = 7
      = 0037            ROAD_LIMIT = 55	;-55..55
      = 000B            MAX_SPEED_ROADSIDE = 11	;(110)
      = 0004            DEC_SPEED_ROADSIDE = 4


      = 0002            rDataPointer = 2
      = 0003            r3Buf = 3
      = 0004            r4buf = 4
      = 0005            r5Buf = 5

      = 0006            rLoTimer = 6
      = 0006            rHiCounter = 6
      = 0007            rScreenYAdr = 7
      = 0008            rHiCarX = 8
      = 0008            rLoWheel = 8
      = 0009            rLoDxCorr = 9
      = 0009            rHiDeltaX = 9
      = 000A            rRoadSectorAdr = 10
      = 000B            rMarksWidthY = 11
      = 000C            rHiSpeed = 12
      = 000C            rloSpeedCounter = 12
      = 000D            rBeepTimer = 13
      = 000E            rTonePointer = 14
      = 000F            rGlobalState = 15

      = 0033            mRoadSize = 51
      = 0034            mRoadStartAdr = 52
      = 0035            mPerspectiveY = 53
                        ;54-56 used
      = 0039            mData = 57

                         ; RAM+$00..$27 is the live road-curve work area.  Do not place persistent
                        ; HUD graphics here while a race is active.
                        ;mTopText remains defined only as terminal scratch; displayRefresh uses ROM.
      = 0800            mTopText = RAM+0

                        ; Exact cumulative elapsed whole seconds, kept separate from the visible TIME
                        ; cells so the inter-road lap overlay can reuse those cells without losing state.
                        ; Tenths come directly from the same R6 phase used by LEFT.
      = 0028            mElapsedHiddenHi = 40
      = 0029            mElapsedHiddenMid = 41
      = 002A            mElapsedHiddenLow = 42
      = 002B            mRoadStartSeconds = 43
      = 002C            mRoadStartTenth = 44
      = 002D            mRoadNumber = 45

      = 003A            mSpeedHi = 58
      = 003C            mSpeedLo = 60
      = 003D            mSpeedSpace = 61
                        ; LEFT display cells: SS.T
      = 003E            mLeftHi = 62
      = 003F            mLeftLow = 63
      = 0040            mLeftDot = 64
      = 0041            mLeftTenth = 65
                        ; TIME display cells: _SSS.T
      = 0042            mElapsedBlank = 66
      = 0043            mElapsedSecHi = 67
      = 0044            mElapsedSecMid = 68
      = 0045            mElapsedSecLow = 69
      = 0046            mElapsedDot = 70
      = 0047            mElapsedTenth = 71
      = 0048            mElapsedFrac = 72		; exact 0..5 active-frame remainder within the displayed tenth

                        ; Saved subsecond phase for a completed road.
      = 004A            mRacePhase = 74
      = 004B            mRacePhaseValid = 75
                        ; Hidden whole-second LEFT state.
      = 004C            mTimerSecHi = 76
      = 004D            mTimerSecLow = 77
                        ; Dedicated completed-lap storage.  Keep lap results completely separate from
                        ; the live TIME display.
      = 004E            mLapTens = 78
      = 004F            mLapOnes = 79
      = 0050            mLapTenth = 80

      = 0858            mBtmDigits = RAM+88
      = 0880            mBtmHorizonStart = RAM+128
      = 08FF            mBtmHorizonEnd = RAM+255

0030                    		.org $30
                        ; Active light-frame LEFT formatter. R6.0 has already been normalized by
                        ; updateTimerBtm, so the hidden seconds and phase describe the same instant.
0030                    formatLeftHud:
0030  86                		glo rLoTimer
0031  FA 3F             		ani $3F
0033  FC C0             		adi <phaseTenthTable
0035  A5                		plo r5Buf
0036  F8 0E             		ldi >phaseTenthTable
0038  B5                		phi r5Buf
0039  05                		ldn r5Buf			; displayed elapsed tenth q
003A  A5                		plo r5Buf
003B  F8 41             		ldi <mLeftTenth
003D  A2                		plo rDataPointer
003E  85                		glo r5Buf
003F  32 5E             		bz formatLeftWhole
0041  FD 0A             		sdi 10
0043  52                		str rDataPointer
0044  F8 4D             		ldi <mTimerSecLow
0046  A2                		plo rDataPointer
0047  02                		ldn rDataPointer
0048  32 52             		bz formatLeftBorrow
004A  FF 01             		smi 1
004C  A4                		plo r4buf
004D  22                		dec rDataPointer
004E  02                		ldn rDataPointer
004F  B4                		phi r4buf
0050  30 68             		br formatLeftStore
0052                    formatLeftBorrow:
0052  22                		dec rDataPointer
0053  02                		ldn rDataPointer
0054  32 5E             		bz formatLeftWhole
0056  FF 01             		smi 1
0058  B4                		phi r4buf
0059  F8 09             		ldi 9
005B  A4                		plo r4buf
005C  30 68             		br formatLeftStore
005E                    formatLeftWhole:
005E  F8 00             		ldi 0
0060  52                		str rDataPointer
0061  F8 4C             		ldi <mTimerSecHi
0063  A2                		plo rDataPointer
                        		; Keep the packed formatter at the same size.  Whole-tenth handling,
                        		; including the exact 00.0 terminal check, lives in the safe $04xx gap.
0064  C0 04B8           		lbr formatLeftWholeSafe
0067  C4                		nop
0068                    formatLeftStore:
0068  F8 3E             		ldi <mLeftHi
006A  A2                		plo rDataPointer
006B  94                		ghi r4buf
006C  52                		str rDataPointer
006D  12                		inc rDataPointer
006E  84                		glo r4buf
006F  52                		str rDataPointer
0070  C0 01CA           		lbr formatLeftHudReturn

                        ; One exact elapsed whole-second tick.  This replaces the former dead low-RAM
                        ; legend copier and runs only when LEFT crosses a whole-second boundary.
0073                    incrementElapsedSecond:
0073  F8 2A             		ldi <mElapsedHiddenLow
0075  A2                		plo rDataPointer
0076                    incrementElapsedDigit:
0076  02                		ldn rDataPointer
0077  FC 01             		adi 1
0079  FF 0A             		smi 10
007B  3B 83             		bnf incrementElapsedStore
007D  F8 00             		ldi 0
007F  52                		str rDataPointer
0080  22                		dec rDataPointer
0081  30 76             		br incrementElapsedDigit
0083                    incrementElapsedStore:
0083  FC 0A             		adi 10
0085  52                		str rDataPointer
0086  C0 0195           		lbr decrementLeftReturn

008C                    		.org $8C
                        ; Hidden whole-second countdown. The display cells are independent.
008C                    decrementLeftSecond:
008C  F8 4D             		ldi <mTimerSecLow
008E  A2                		plo rDataPointer
008F  02                		ldn rDataPointer
0090  3A A6             		bnz decrementLeftLow
0092  22                		dec rDataPointer
0093  02                		ldn rDataPointer
0094  3A 9C             		bnz decrementLeftBorrow
0096  F8 FF             		ldi 255
0098  AF                		plo rGlobalState
0099  C0 0464           		lbr setGameOverHud
009C                    decrementLeftBorrow:
009C  FF 01             		smi 1
009E  52                		str rDataPointer
009F  12                		inc rDataPointer
00A0  F8 09             		ldi 9
00A2  52                		str rDataPointer
00A3  C0 0073           		lbr incrementElapsedSecond
00A6                    decrementLeftLow:
00A6  FF 01             		smi 1
00A8  52                		str rDataPointer
00A9  C0 0073           		lbr incrementElapsedSecond

                        ; Initial numeric row and exact timer/budget state. Subsequent road transitions
                        ; preserve the lap row written by finishLapCapture instead of calling this.
00AC                    initHudData:
00AC  F8 4C             		ldi <mTimerSecHi
00AE  A2                		plo rDataPointer
00AF  F8 06             		ldi TIMER_START_HI
00B1  52                		str rDataPointer
00B2  12                		inc rDataPointer
00B3  F8 05             		ldi TIMER_START_LO
00B5  52                		str rDataPointer
00B6  F8 28             		ldi <mElapsedHiddenHi
00B8  A2                		plo rDataPointer
00B9  F8 00             		ldi 0
00BB  52                		str rDataPointer
00BC  12                		inc rDataPointer
00BD  52                		str rDataPointer
00BE  12                		inc rDataPointer
00BF  52                		str rDataPointer
00C0  F8 2D             		ldi <mRoadNumber
00C2  A2                		plo rDataPointer
00C3  F8 01             		ldi 1
00C5  52                		str rDataPointer

00C6  F8 00             		ldi >initialHudChars
00C8  B4                		phi r4buf
00C9  F8 DC             		ldi <initialHudChars
00CB  A4                		plo r4buf
00CC  F8 3A             		ldi <mSpeedHi
00CE  A2                		plo rDataPointer
00CF  F8 0E             		ldi 14
00D1  A5                		plo r5Buf
00D2                    initHudDataLoop:
00D2  44                		lda r4buf
00D3  52                		str rDataPointer
00D4  12                		inc rDataPointer
00D5  25                		dec r5Buf
00D6  85                		glo r5Buf
00D7  3A D2             		bnz initHudDataLoop
00D9  C0 02F9           		lbr waitVsync
00DC                    initialHudChars:
00DC  0000000A 06059A00 		.db 0,0,0,<chr_, 6,5,<chrDot,0, <chr_,0,0,0,<chrDot,0
00E4  0A000000 9A00

                        ; Inter-road lap result.  The completed lap never aliases TIME.  A small
                        ; helper writes NN.N into the existing LEFT numeric cells during the countdown;
                        ; active-race HUD updates naturally reclaim those four cells afterward.
00EA                    showLapHud:
00EA  C0 04CA           		lbr showLapHudSafe
00ED  C4                		nop
00EE  C4                		nop
00EF  C4                		nop
00F0  C4                		nop

0100                    	.org 100h
0100                    start:
0100  E2                		sex r2
0101  22                		dec r2
0102  69                		inp 1		; turns video on
0103  12                		inc r2
                        		;disable interrupt and set X = 2, P = 3
0104  E3                		sex r3
0105  71                		dis
0106  23                		.db  $23
                        		
0107  7A                		req ;sound off

0108  F8 08             		ldi >RAM
010A  B2                		phi rDataPointer
010B  B7                		phi rScreenYAdr

