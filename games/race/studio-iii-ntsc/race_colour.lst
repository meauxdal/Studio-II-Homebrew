04C0  52                		str rDataPointer
04C1  12                		inc rDataPointer
04C2  52                		str rDataPointer
04C3  12                		inc rDataPointer		; decimal point
04C4  12                		inc rDataPointer		; tenths
04C5  52                		str rDataPointer
04C6  C0 0365           		lbr updateSpeed

